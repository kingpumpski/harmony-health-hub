      "requires_public_revoke": true,
      "requires_anon_revoke": true
    },
    "create_pharmacy_pos_sale": {
      "signatures": ["uuid,uuid,integer"],
      "allowed_execute_roles": ["authenticated"],
      "requires_public_revoke": true,
      "requires_anon_revoke": true
    },
    "create_appointment_workflow": {
      "signatures": [
        "uuid,timestamptz,text,text",
        "uuid,timestamptz,text,text,text,uuid"
      ],
      "allowed_execute_roles": ["authenticated"],
      "requires_public_revoke": true,
