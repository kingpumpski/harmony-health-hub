      "allowed_execute_roles": ["authenticated"],
      "requires_public_revoke": true,
      "requires_anon_revoke": true
    },
    "search_patient_directory": {
      "signatures": ["text,integer"],
      "allowed_execute_roles": ["authenticated"],
      "requires_public_revoke": true,
      "requires_anon_revoke": true
    }
  }
}
